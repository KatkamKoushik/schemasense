# ==============================================================================
# SchemaSense Configuration & Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Security Guards
# ------------------------------------------------------------------------------
# Operating environment: development | staging | production
# In production, local evaluation is strictly blocked and security controls fail closed.
SCHEMASENSE_ENV=development

# Explicit opt-in for local evaluation mode: true | 1 | yes (default: false)
# When set to true in a non-production environment without an access key configured,
# permits operators to run and test locally under the "Local Operator" persona.
# Set to false or omit in staging/production.
SCHEMASENSE_ENABLE_LOCAL_EVALUATION=true

# Enterprise Security Key / Token Barrier (optional for development, recommended for standalone)
# When set, locks the console behind a security token barrier.
# Evaluation mode CANNOT bypass a configured access key.
# SCHEMASENSE_ACCESS_KEY=your-secure-enterprise-token

# Mandatory Authentication Gate: true | 1 | yes (default: false)
# When true, blocks unauthenticated access even if no access key is configured.
# SCHEMASENSE_REQUIRE_AUTH=false

# Trusted Reverse Proxy Headers: true | 1 | yes (default: false)
# Enable only when running behind an authenticating reverse proxy (Cloudflare Access, AWS ALB, Pomerium).
# SCHEMASENSE_TRUST_PROXY_HEADERS=false

# SSRF Network Sandbox: 1 permits private network/localhost IPs (for local testing);
# Set to 0 in production to block loopbacks and RFC 1918 / RFC 3927 metadata ranges.
SCHEMASENSE_ALLOW_LOCAL_CONNECTIONS=1

# ------------------------------------------------------------------------------
# 2. Federated OAuth 2.0 Single Sign-On (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0 Credentials
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Public Redirect URI
# SCHEMASENSE_REDIRECT_URI=http://localhost:8501

# ------------------------------------------------------------------------------
# 3. AI Inference Providers (Optional - at least one required for AI features)
# ------------------------------------------------------------------------------
# Google Gemini API
# GEMINI_API_KEY=AIzaSy...

# OpenAI API
# OPENAI_API_KEY=sk-...

# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek API
# DEEPSEEK_API_KEY=sk-...

# Groq API
# GROQ_API_KEY=gsk_...

